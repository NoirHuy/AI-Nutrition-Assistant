# ============================================================
# EDC Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# ── VPS LLM Endpoint (primary — used for all phases) ──────────
# Your custom model API hosted on your VPS.
VPS_API_KEY=your_vps_api_key_here
VPS_API_BASE_URL=http://your_vps_ip:port/v1
# The model name your VPS API expects in the `model` field.
VPS_MODEL_NAME=extract_graph

# ── API Key Pool (legacy / fallback) ────────────────────────
# OpenRouter keys are loaded via the APIKeyPool in llm_utils.py
# (supports multiple keys with automatic rotation on 402 failures).
# Add one or more keys:
OPENROUTER_API_KEY=your_openrouter_key_here

# Groq API (optional fallback — free tier available)
# GROQ_KEY=your_groq_key_here

# ── UMLS (optional — for post-processing enrichment) ──────────
# Get a free key at: https://uts.nlm.nih.gov/uts/usermanagement
# UMLS_API_KEY=your_umls_key_here
